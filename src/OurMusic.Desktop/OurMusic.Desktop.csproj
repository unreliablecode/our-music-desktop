<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.2.1</Version>
    <AssemblyName>OurMusic.Desktop</AssemblyName>
    <AssemblyTitle>Our Music - Desktop</AssemblyTitle>
    <Product>Our Music - Desktop</Product>
    <Description>Windows music player with local recommendations</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../tools/yt-dlp.exe" Link="tools/yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../tools/yt-dlp.exe')"/>
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="recommendations.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
